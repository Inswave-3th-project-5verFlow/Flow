						<w2:key dataType="text" id="pjtName" name="프로젝트명"></w2:key>
						<w2:key dataType="text" id="pjtAsi" name="프로젝트관리자"></w2:key>
						<w2:key dataType="text" id="pjtStatus" name="프로젝트상태" defaultValue="대기"></w2:key>
						<w2:key dataType="text" id="pjtDetail" name="상세설명"></w2:key>
						<w2:key dataType="text" id="pjtSt" name="시작일"></w2:key>
						<w2:key dataType="text" id="pjtEt" name="완료일"></w2:key>

						<w2:key dataType="text" name="유저ID" id="userId"></w2:key>
						<w2:key dataType="text" name="그룹ID" id="grpId"></w2:key>
					</w2:keyInfo>
				</w2:dataMap>
				<w2:dataList baseNode="list" repeatNode="map" id="dlt_pjtStatusList" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column dataType="text" name="라벨" id="label"></w2:column>
						<w2:column dataType="text" name="상태" id="pjtStatus"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<label><![CDATA[대기]]></label>
							<pjtStatus><![CDATA[대기]]></pjtStatus>
						</w2:row>
						<w2:row>
							<label><![CDATA[진행중]]></label>
							<pjtStatus><![CDATA[진행중]]></pjtStatus>
						</w2:row>
						<w2:row>
							<label><![CDATA[완료]]></label>
							<pjtStatus><![CDATA[완료]]></pjtStatus>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
			<w2:workflowCollection></w2:workflowCollection>
			<xf:submission id="sbm_insertPjtVo" ref='data:json,{"id":"dmp_pjtVoDetail","key":"elData"}' target=""
				action="/InsWebApp/PjtIns.pwkjson" method="post" mediatype="application/json" encoding="UTF-8" instance="" replace="" errorHandler=""
				customHandler="" mode="asynchronous" processMsg="" ev:submit="" ev:submitdone="scwin.sbm_insertPjtVo_submitdone" ev:submiterror=""
				abortTrigger="">
			</xf:submission>
		</xf:model>
		<w2:layoutInfo></w2:layoutInfo>
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript"><![CDATA[// 전역 변수 초기화
scwin.LOGIN_USER_ID = "";
scwin.LOGIN_USER_NAME = "";
scwin.GROUP_ID = "";

/**
 * @method
 * @name scwin.onpageload
 * @description 페이지가 로드될 때 사용자 정보를 설정하고 기본 값을 초기화한다.
 * @example
 * scwin.onpageload();
 */
scwin.onpageload = function () {
    scwin.LOGIN_USER_ID = "1";
    scwin.LOGIN_USER_NAME = "김프로젝트";
    scwin.GROUP_ID = "1";

    dmp_pjtVoDetail.set("userId", scwin.LOGIN_USER_ID);
    dmp_pjtVoDetail.set("grpId", scwin.GROUP_ID);
    ipt_pjtAsi.setValue(scwin.LOGIN_USER_NAME);
};

/**
 * @method
 * @name scwin.btn_save_onclick
 * @description 저장 버튼 클릭 시 필수 입력값을 확인하고 프로젝트 등록을 요청한다.
 * @param {Event} e - 클릭 이벤트 객체
 * @example
 * <w2:trigger id="btn_save" onClick="scwin.btn_save_onclick" />
 */
scwin.btn_save_onclick = function (e) {
    if ($c.util.isEmpty(ipt_pjtName.getValue().trim())) {
        $c.win.alert("프로젝트명은 필수입니다.");
        return;
    }

    if ($c.util.isEmpty(ipt_pjtStatus.getValue().trim())) {
        $c.win.alert("상태는 필수입니다.");
        return;
    }

    $c.sbm.execute(sbm_insertPjtVo);
};

/**
 * @method
 * @name scwin.sbm_insertPjtVo_submitdone
 * @description 프로젝트 등록 서브미션 완료 후 결과를 확인하고 알림을 출력한다.
 * @param {Object} e - 서브미션 완료 이벤트 객체
 * @example
 * <w2:submission id="sbm_insertPjtVo" submitDone="scwin.sbm_insertPjtVo_submitdone" />
 */
scwin.sbm_insertPjtVo_submitdone = function (e) {
    var elData = e.responseJSON.elData;
    var elHeader = e.responseJSON.elHeader;

    if (elHeader == null || elHeader === "" || elHeader === "undefined" || elHeader.resSuc === false) {
        $c.win.alert(`에러코드 : ${elHeader.resCode}\n에러메시지 : ${elHeader.resMsg}`);
        return false;
    }

    $c.win.alert("등록이 완료되었습니다.");
};

/**
 * @method
 * @name scwin.btn_refresh_onclick
 * @description 새로고침 버튼 클릭 시 입력폼과 데이터맵을 초기화한다.
 * @param {Event} e - 클릭 이벤트 객체
 * @example
 * <w2:trigger id="btn_refresh" onClick="scwin.btn_refresh_onclick" />
 */
scwin.btn_refresh_onclick = function (e) {
    dmp_pjtVoDetail.setEmptyValue();
    dmp_pjtVoDetail.set("userId", scwin.LOGIN_USER_ID);
    dmp_pjtVoDetail.set("grpId", scwin.GROUP_ID);
    ipt_pjtAsi.setValue(scwin.LOGIN_USER_NAME);
    ipt_pjtSt.setValue("");
    ipt_pjtEt.setValue("");
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
