<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head meta_screenName="로그인 화면">
        <w2:type>COMPONENT</w2:type>
        <w2:buildDate/>
        <w2:MSA/>
        <xf:model>
        	<w2:dataCollection baseNode="map">
        		<w2:dataMap baseNode="map" id="dma_login">
        			<w2:keyInfo>
        				<w2:key dataType="text" name="아이디" id="id"></w2:key>
        				<w2:key dataType="text" name="패스워드" id="pw"></w2:key>
        			</w2:keyInfo>
        		</w2:dataMap>
        	</w2:dataCollection>
        	<w2:workflowCollection />
        	<xf:submission id="sbm_login" action="/InsWebApp/Login.pwkjson" method="post" mediatype="application/json"
        		ref='data:json,{"id":"dma_login","key":"elData"}' target="" encoding="UTF-8" instance="" replace="" errorHandler=""
        		customHandler="" mode="asynchronous" processMsg="로그인 처리중..." ev:submit="" ev:submitdone="scwin.sbm_login_submitdone"
        		ev:submiterror="" abortTrigger="">
        	</xf:submission>
        </xf:model>
        <w2:layoutInfo/>
        <w2:publicInfo method=""/>
        <script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
	
};

// 아이디 입력
scwin.id_input_onclick = function (e) {
    id_input.setValue("");
};

// 패스워드 입력
scwin.pw_input_onclick = function (e) {
    pw_input.setValue("");
};

// 로그인 버튼 클릭시 로그인 처리
scwin.btn_login_onclick = function (e) {
    var userId = $p.getComponentById("id_input").getValue();
    var plainPassword = $p.getComponentById("pw_input").getValue();

    // 아이디 혹은 비밀번호가 Null값일 경우
    if (!userId || !plainPassword) {
        alert("아이디와 비밀번호를 입력하세요.");
        return;
    }

    $c.sbm.execute(sbm_login);
};

// 로그인 완료 처리 후
scwin.sbm_login_submitdone = function (e) {

    var elHeader = e.responseJSON.elHeader; // 응답 전문 elHeader
    var userHeader = e.responseJSON.userHeader;

    if(userHeader != "" && userHeader != null && userHeader != "undefined") {
        if(elHeader.resSuc == true) {
           WebSquare.cookie.setCookie("usrId", userHeader.usrId);

           location.href = "/InsWebApp/websquare/websquare.html?w2xPath=/InsWebApp/ui/testMain.xml";
        } else {
            alert(elHeader.resMsg);
        }
    }
};]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
    	<xf:image src="/InsWebApp/ui/city.png" style="width: 100%;height: 600px;" id=""></xf:image>
    	<xf:group class="sub_contents" id="" meta_snippetCategory="00_화면시작" meta_snippetKeyComponent="true" meta_snippetName="0_01 페이지시작"
    		style="display: flex;justify-content: center;align-items: center;">
    		<xf:group style="width: 400px;height: 300px;" id="">
    			<xf:group style="margin-bottom: 10px;display: flex;justify-content: center;" id="">
    			</xf:group>
    			<xf:group style="margin-bottom: 30px;display: flex;justify-content: center;" id="">
    				<w2:span meta_snippetCategory="10_입력폼" meta_snippetName="10_16 출력텍스트" meta_snippetKeyComponent="true"
    					style="font-size: 20px;font-weight: bold;" id="" label="프로젝트 관리의 새로운 경험을 시작하세요">
    				</w2:span>
    			</xf:group>
    			<xf:group style="margin-left: 60px;" id="">
    				<w2:span meta_snippetCategory="10_입력폼" meta_snippetName="10_16 출력텍스트" meta_snippetKeyComponent="true"
    					style="font-size: 16px;font-weight: bold;color: 	#808080;" id="" label="ID">
    				</w2:span>
    			</xf:group>
    			<xf:group style="display: flex;justify-content: center;" id="">
    				<xf:input ref="data:dma_login.id" meta_snippetCategory="10_입력폼" meta_snippetName="10_01 InputBox"
    					ev:onclick="scwin.id_input_onclick" meta_snippetKeyComponent="true"
    					style="margin-top: 10px;margin-bottom: 20px;border-radius: 8px;width: 70%;" id="id_input" placeholder="" class=""
    					initValue="아이디를 입력하세요">
    				</xf:input>
    			</xf:group>
    			<xf:group style="margin-left: 60px;" id="">
    				<w2:span meta_snippetCategory="10_입력폼" meta_snippetName="10_16 출력텍스트" meta_snippetKeyComponent="true"
    					style="font-size: 16px;font-weight: bold;color: 	#808080;" id="" label="PASSWORD">
    				</w2:span>
    			</xf:group>
    			
    			<xf:group style='display: flex;justify-content: center;' id="">
    				<xf:input ref="data:dma_login.pw" meta_snippetCategory="10_입력폼" meta_snippetName="10_01 InputBox"
    					ev:onclick="scwin.pw_input_onclick" ev:onkeydown="scwin.pw_input_onkeydown" meta_snippetKeyComponent="true"
    					style="margin-top: 10px;margin-bottom: 40px;border-radius: 8px;width: 70%;" id="pw_input" placeholder="" type="password" class=""
    					initValue="패스워드를 입력하세요">
    				</xf:input>
    			</xf:group>
    			<xf:group meta_snippetCategory="08_버튼" meta_snippetName="8_04 전체제어버튼" meta_snippetKeyComponent="true" style="margin-left: 60px;" id=""
    				class="btnbox lt">
    				<xf:trigger ev:onclick="scwin.btn_login_onclick"
    					style="width: 30%;height: 30px;border-radius: 8px;font-size: 14px;background: #f1fafb;" id="btn_login" type="button">
    					<xf:label><![CDATA[로그인]]></xf:label>
    				</xf:trigger>
    			</xf:group>
    		</xf:group>
    	</xf:group>
    </body>
</html>
