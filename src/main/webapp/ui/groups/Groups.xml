		<script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function () {

    $c.sbm.execute($p, sbm_selectGroupsVoList);


};

// 페이지 번호 클릭 이벤트
scwin.pgl_groupsList_onclick = function (idx) {

    // 페이지 번호 세팅
    dmp_groupsVo.set("pageIndex", idx);

    // 서버통신 - 그룹정보 조회
    $c.sbm.execute($p, sbm_selectGroupsVoList);
};

// 행추가 버튼 이벤트
scwin.btn_insert_onclick = function (e) {

    var focus = grd_list.getFocusedRowIndex();
    dlt_groupsVoList.insertRow(focus + 1);
};

// 다중행삭제 버튼 클릭 시 체크한 행 일괄 
scwin.btn_removeRows_onclick = function (e) {

    var chkIdxArr = grd_list.getCheckedIndex("checkBox");
    dlt_groupsVoList.removeRows(chkIdxArr);
};

// 초기화 버튼 클릭시 화면에 데이터 모두 제거
scwin.btn_reset_onclick = function (e) {

    dlt_groupsVoList.setData([]);

};


scwin.sbm_groupsList_submitdone = function (e) {

    // error 수신시
    var elData = e.responseJSON.elData;
    var elHeader = e.responseJSON.elHeader;
    if (elHeader == null || elHeader == "" || elHeader == "undefiend" || elHeader.resSuc == false) {
        $c.win.alert(`에러코드 : ${elHeader.resCode}\n에러메시지 : ${elHeader.resMsg}`);
        return false;
    }

    // 총 레코드 수 업데이트
    spn_listCnt.setLabel(elData.totalCount);

    // 페이지 네비게이터 업데이트
    var totalPageCount = Math.ceil(elData.totalCount / dmp_groupsVo.get("pageSize"));
    pgl_groupsList.setCount(totalPageCount);

    // 페이징 정보 업데이트
    spn_totalPageCount.setValue(totalPageCount);
    spn_pageIndex.setValue(dmp_groupsVo.get("pageIndex"));
    pgl_groupsList.setSelectedIndex(dmp_groupsVo.get("pageIndex"));

};

// 등록 버튼 클릭시 등록/수정 팝업창이 뜸
scwin.btn_reg_onclick = function (e) {
    popup.show();
};


// 저장 버튼클릭 시 입력값 서버로 전송
scwin.btn_save_onclick = function (e) {
    // 다건 신규입력, 수정, 삭제 한꺼번에 처리
    let reqObj = {
        "elData": { "groupsVoList": dlt_groupsVoList.getModifiedJSON() }
    };
    console.log(dlt_groupsVoList.getModifiedJSON());
    $c.sbm.execute(sbm_saveGroupsVoList, reqObj);
};

// 저장 이후 수행되는 로직
scwin.sbm_saveGroupsVoList_submitdone = function (e) {
    // error 수신시
    var elHeader = e.responseJSON.elHeader;
    if (elHeader == null || elHeader == "" || elHeader == "undefiend" || elHeader.resSuc == false) {
        $c.win.alert(`에러코드 : ${elHeader.resCode}\n에러메시지 : ${elHeader.resMsg}`);
        return false;
    } else {
        // msg 출력
        $c.win.alert("저장되었습니다.");
    }

    // 저장 후 페이지 재업로드
    scwin.onpageload;
};
]]></script>
