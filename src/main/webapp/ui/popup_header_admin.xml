    		</xf:group>
    		<xf:group class="pgtbox" id="" meta_snippetCategory="02_타이틀" meta_snippetKeyComponent="true" meta_snippetName="2_01 페이지타이틀"
    			style="">
    			<xf:trigger id="btn_logout" style="height: 35px;width: 100%;border-radius: 8px; font-weight: bold; box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);" type="button" ev:onclick="scwin.btn_logout_onclick" class="admin-btn">
    				<xf:label><![CDATA[로그아웃]]></xf:label>
    			</xf:trigger>
    		</xf:group>
    	</xf:group>
    </body>
</html>
