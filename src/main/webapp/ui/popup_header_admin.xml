    		<xf:group class="pgtbox" id="" meta_snippetCategory="02_타이틀" meta_snippetKeyComponent="true" meta_snippetName="2_01 페이지타이틀"
    			style="">
    			<xf:trigger type="button" style="height: 35px;width: 100%;border-radius: 8px; font-weight: bold; box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);" id="btn_userListPage" ev:onclick="scwin.btn_userListPage_onclick" class="admin-btn">
    				<xf:label><![CDATA[사용자관리]]></xf:label>
    			</xf:trigger>
    		</xf:group>
    		<xf:group class="pgtbox" id="" meta_snippetCategory="02_타이틀" meta_snippetKeyComponent="true" meta_snippetName="2_01 페이지타이틀"
    			style="">
    			<xf:trigger id="btn_groupPage" style="height: 35px;width: 100%;border-radius: 8px; font-weight: bold; box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);" type="button" ev:onclick="scwin.btn_groupPage_onclick" class="admin-btn">
    				<xf:label><![CDATA[그룹관리]]></xf:label>
    			</xf:trigger>
    		</xf:group>
    		<xf:group meta_snippetCategory="02_타이틀" meta_snippetName="2_01 페이지타이틀" meta_snippetKeyComponent="true" style="" id=""
    			class="pgtbox">
    			<xf:trigger style="height: 35px;width: 100%;border-radius: 8px; font-weight: bold; box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);" id="btn_menuPage" type="button" ev:onclick="scwin.btn_menuPage_onclick" class="admin-btn">
    				<xf:label><![CDATA[메뉴관리]]></xf:label>
