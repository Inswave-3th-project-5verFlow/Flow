        <script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function () {
    let jsnParamData = $p.getParameter("taskData")

    if (jsnParamData != undefined) {
        taskVoDetail.setJSON(jsnParamData);

    }
};

// 저장 버튼
scwin.btn_save_onclick = function (e) {

    let jsnParamData = $p.getParameter("taskData")
    console.log(jsnParamData.rowStatus);
    // 유효성 체크
    var valInfo = [
        { id: "taskId", mandatory: false }

    ];

    if ($c.data.validateGroup(task_table, valInfo) === true) {
        let promise = $c.win.confirm("저장하시겠습니까?");
        promise.then(function (result) {
            if (result) {
                if (jsnParamData.rowStatus === 'C') {
                    $c.sbm.execute(sbm_insertTaskVo);
                }
                else {
                    $c.sbm.execute(sbm_updateTaskVo);
                }
            }
        })
    }
};

// 저장 버튼 클릭 이후 -> 추가일 경우.
scwin.sbm_insertTaskVo_submitdone = function (e) {
    // error 수신시
    var elHeader = e.responseJSON.elHeader;
    if (elHeader == null || elHeader == "" || elHeader == "undefiend" || elHeader.resSuc == false) {
        $c.win.alert(`에러코드 : ${elHeader.resCode}\n에러메시지 : ${elHeader.resMsg}`);
        return false;
    } else {
        // 등록되었습니다. msg 출력
        $c.win.alert("추가되었습니다.");
    }
};

// 저장 버튼 클릭 이후 -> 수정일 경우.
scwin.sbm_updateTaskVo_submitdone = function (e) {
    // error 수신시
    var elHeader = e.responseJSON.elHeader;
    if (elHeader == null || elHeader == "" || elHeader == "undefiend" || elHeader.resSuc == false) {
        $c.win.alert(`에러코드 : ${elHeader.resCode}\n에러메시지 : ${elHeader.resMsg}`);
        return false;
    } else {
        // 수정되었습니다. msg 출력
        $c.win.alert("수정되었습니다.");
    };
}

// 삭제 버튼
scwin.btn_delete_onclick = function (e) {
    // 유효성 체크
    var valInfo = [
        { id: "taskId", mandatory: true }

    ];

    if ($c.data.validateGroup(task_table, valInfo) === true) {
        var promise = $c.win.confirm("삭제하시겠습니까?");
        promise.then(function (result) {
            if (result) {
                $c.sbm.execute(sbm_deleteTaskVo);
            }
        })
    }
};

scwin.sbm_deleteTaskVo_submitdone = function (e) {
    // error 수신시
    var elHeader = e.responseJSON.elHeader;
    if (elHeader == null || elHeader == "" || elHeader == "undefiend" || elHeader.resSuc == false) {
        $c.win.alert(`에러코드 : ${elHeader.resCode}\n에러메시지 : ${elHeader.resMsg}`);
        return false;
    } else {
        // 삭제되었습니다. msg 출력
        $c.win.alert("삭제되었습니다.");
    }

};

// 취소 버튼
scwin.btn_close_onclick = function (e) {
    $p.closePopup();
};



]]></script>
