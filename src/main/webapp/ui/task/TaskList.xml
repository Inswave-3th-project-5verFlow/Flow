					</xf:trigger>
				</xf:group>
			</xf:group>
			<xf:group class="titbox" id="" style=";margin-left:0%;">
				<xf:group class="count" id="">
					<w2:span id="" label="총" localeRef="COMMON_LABEL_00002" style=""></w2:span>
					<w2:span class="num" id="spn_listCnt" label="0" ref="" style=""></w2:span>
					<w2:span id="" label="건" localeRef="COMMON_LABEL_00003" style=""></w2:span>
				</xf:group>
				<xf:trigger class="btn_cm rt" id="btn_add" style="" type="button" ev:onclick="scwin.btn_add_onclick">
					<xf:label><![CDATA[추가]]></xf:label>
				</xf:trigger>
				<xf:trigger class="btn_cm" id="btn_delete" style="" type="button" ev:onclick="scwin.btn_delete_onclick">
					<xf:label><![CDATA[삭제]]></xf:label>
				</xf:trigger>
				<xf:trigger class="btn_cm pt" id="btn_save" style="" type="button" ev:onclick="scwin.btn_save_onclick">
					<xf:label><![CDATA[저장]]></xf:label>
				</xf:trigger>
			</xf:group>
			<xf:group adaptiveThreshold="" class="gvwbox" id="" style="">
				<w2:gridView autoFit="allColumn" checkReadOnlyOnPasteEnable="" class="gvw" dataList="data:dlt_taskVoList"
					defaultCellHeight="26" focusMode="row" id="grd_list" scrollByColumn="false" scrollByColumnAdaptive="false" style="height: 150px;"
					visibleRowNum="20" ev:oncellclick="scwin.grd_list_oncellclick" readOnly="false" rowNumVisible="false" rowStatusVisible="true"
					editModeEvent="onclick" sortEvent="onclick" rowStatusHeaderValue="상태" ignoreCellClick="false" ev:oncelldblclick="scwin.grd_list_oncelldblclick">
					<w2:caption style="" id="caption2" value="this is a grid caption."></w2:caption>
					<w2:header style="" id="header2">
						<w2:row style="" id="row3">
							<w2:column width="70" inputType="checkbox" style="" id="" value="" displayMode="label"></w2:column>
							<w2:column width="70" inputType="text" style="" id="column1" value="task_id" displayMode="label"
								localeRef="Task_COLNAME_00001">
							</w2:column>
							<w2:column width="70" inputType="text" style="" id="column2" value="task_name" displayMode="label"
								localeRef="Task_COLNAME_00002">
							</w2:column>
							<w2:column width="70" inputType="text" style="" id="column3" value="task_order" displayMode="label"
								localeRef="Task_COLNAME_00003" useFilter="true" sortable="true">
							</w2:column>
							<w2:column width="70" inputType="text" style="" id="column4" value="task_description" displayMode="label"
								localeRef="Task_COLNAME_00004">
							</w2:column>
							<w2:column width="70" inputType="text" style="" id="column5" value="start_date" displayMode="label"
								localeRef="Task_COLNAME_00005" sortable="true" useFilter="true">
							</w2:column>
							<w2:column width="70" inputType="text" style="" id="column6" value="end_date" displayMode="label"
								localeRef="Task_COLNAME_00006" sortable="true" useFilter="true">
							</w2:column>
							<w2:column width="70" inputType="text" style="" id="column7" value="task_status" displayMode="label"
								localeRef="Task_COLNAME_00007">
							</w2:column>
							<w2:column width="70" inputType="text" style="" id="column8" value="stg_id" displayMode="label"
								localeRef="Task_COLNAME_00008">
							</w2:column>

						</w2:row>
					</w2:header>
					<w2:gBody style="" id="gBody2">
						<w2:row style="" id="row4">
							<w2:column width="70" inputType="checkbox" style="" id="chk" value="" displayMode="label" readOnly="false"></w2:column>
							<w2:column width="70" inputType="text" style="" id="taskId" value="" displayMode="label" readOnly="true"></w2:column>
							<w2:column width="70" inputType="text" style="" id="taskName" value="" displayMode="label"></w2:column>
							<w2:column width="70" inputType="text" style="" id="taskOrder" value="" displayMode="label"></w2:column>
							<w2:column width="70" inputType="text" style="" id="taskDescription" value="" displayMode="label"></w2:column>
							<w2:column width="70" inputType="calendar" style="" id="startDate" value="" displayMode="label"></w2:column>
							<w2:column width="70" inputType="calendar" style="" id="endDate" value="" displayMode="label"></w2:column>
							<w2:column width="70" inputType="select" style="" id="taskStatus" value="" displayMode="label" allOption=""
								chooseOption="" ref="">
