<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<w2:MSA />
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataMap baseNode="map" id="dmp_taskVo" style="">
					<w2:keyInfo>
						<w2:key dataType="text" id="scTaskName" name="search_task_name"></w2:key>

						<w2:key dataType="text" id="pageIndex" name="페이지_번호" defaultValue="1"></w2:key>
						<w2:key dataType="text" id="pageSize" name="페이지_건수" defaultValue="15"></w2:key>
					</w2:keyInfo>
					<w2:data use="false"></w2:data>
				</w2:dataMap>
				<w2:dataList baseNode="list" id="dlt_taskVoList" repeatNode="map" saveRemovedData="true" style="">
					<w2:columnInfo>
						<w2:column dataType="text" id="taskId" name="task_id"></w2:column>
						<w2:column dataType="text" id="taskName" name="task_name"></w2:column>
						<w2:column dataType="text" id="taskOrder" name="task_order"></w2:column>
						<w2:column dataType="text" id="taskDescription" name="task_description"></w2:column>
						<w2:column dataType="text" id="startDate" name="start_date"></w2:column>
						<w2:column dataType="text" id="endDate" name="end_date"></w2:column>
						<w2:column dataType="text" id="taskStatus" name="task_status"></w2:column>
						<w2:column dataType="text" id="stgId" name="stg_id"></w2:column>

						<w2:column id="chk" name="chk" dataType="text" ignoreStatus="true"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
				<w2:dataMap baseNode="map" id="dmp_taskVoDetail" style="">
					<w2:keyInfo>

					</w2:keyInfo>
				</w2:dataMap>
				<w2:dataList baseNode="list" repeatNode="map" id="dlt_taskStatus" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column dataType="text" name="name2" id="label"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<label><![CDATA[대기]]></label>

						</w2:row>
						<w2:row>
							<label><![CDATA[진행중]]></label>

						</w2:row>
						<w2:row>
							<label><![CDATA[완료]]></label>

						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
			<w2:workflowCollection></w2:workflowCollection>

			<xf:submission id="sbm_selectTaskVoList" ref='data:json,{"id":"dmp_taskVo","key":"taskVo"}'
				target='data:json,{"id":"dlt_taskVoList","key":"elData.taskVoList"}' action="/InsWebApp/TASK001List.pwkjson" method="post"
				mediatype="application/json" encoding="UTF-8" instance="" replace="" errorHandler="" customHandler="" mode="asynchronous"
				processMsg="업무정보 리스트를 조회 중입니다." ev:submit="" ev:submitdone="scwin.sbm_taskList_submitdone" ev:submiterror="" abortTrigger="">
			</xf:submission>
			<xf:submission id="sbm_saveTaskVoList" action="/InsWebApp/TASK001Save.pwkjson" method="post" mediatype="application/json" ref="" target="" encoding="UTF-8"
				instance="" replace="" errorHandler="" customHandler="" mode="asynchronous" processMsg="" ev:submit="" ev:submitdone="scwin.sbm_saveTaskVoList_submitdone"
				ev:submiterror="" abortTrigger="">
			</xf:submission>
		</xf:model>
		<w2:layoutInfo></w2:layoutInfo>
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function () {
    //search_box
    var cptIbxName = $p.getComponentById("searchComp_1");
    if (cptIbxName == undefined) {
        search_box.hide();
    }

    // 업무정보 조회
    scwin.btn_search_onclick();
};

/************************** 이벤트 함수 *************************/

/**
 * 조회 버튼 클릭 이벤트
 * @date
 * @memberOf
 * @param 
 * @returns
 * @author 
 * @example
 */
scwin.btn_search_onclick = function (e) {
    // PGAE번호 초기화
    dmp_taskVo.set("pageIndex", "1");
    pgl_taskList.setSelectedIndex(1);


    // 서버통신 - 업무정보 조회
    $c.sbm.execute($p, sbm_selectTaskVoList);


};

scwin.sbm_taskList_submitdone = function (e) {

    // error 수신시
    var elData = e.responseJSON.elData;
    var elHeader = e.responseJSON.elHeader;
    if (elHeader == null || elHeader == "" || elHeader == "undefiend" || elHeader.resSuc == false) {
        $c.win.alert(`에러코드 : ${elHeader.resCode}\n에러메시지 : ${elHeader.resMsg}`);
        return false;
    }

    // 업무정보 dataMap 초기화
    dmp_taskVoDetail.setEmptyValue();

    // 총 레코드 수 업데이트
    spn_listCnt.setLabel(elData.totalCount);

    // 데이터를 그리드에 셋팅
    dlt_taskVoList.setJSON(elData.taskVoList);

    // 페이지 네비게이터 업데이트
    var totalPageCount = Math.ceil(elData.totalCount / dmp_taskVo.get("pageSize"));
    pgl_taskList.setCount(totalPageCount);

    // 페이징 정보 업데이트
    spn_totalPageCount.setValue(totalPageCount);
    spn_pageIndex.setValue(dmp_taskVo.get("pageIndex"));
    pgl_taskList.setSelectedIndex(dmp_taskVo.get("pageIndex"));
};

/**
 * 페이지 번호 클릭 이벤트
 * @date
 * @memberOf
 * @param 
 * @returns 
 * @author 
 * @example
 */
scwin.pgl_taskList_onclick = function (idx) {

    // 페이지 번호 세팅
    dmp_taskVo.set("pageIndex", idx);
    // 서버통신 - 사원목록 조회
    $c.sbm.execute($p, sbm_selectTaskVoList);
};


scwin.btn_reset_onclick = function (e) {
    scTaskName.setValue("")
    // PGAE번호 초기화
    dmp_taskVo.set("pageIndex", "1");
    pgl_taskList.setSelectedIndex(1);

    // 서버통신 - 업무정보 조회
    $c.sbm.execute($p, sbm_selectTaskVoList);
};

// 검색 조건에서 엔터 키 입력 기능 추가.
scwin.scTaskName_onkeyup = function (e) {
    if (e.keyCode === 13) {
        setTimeout(function () {
            // PGAE번호 초기화
            dmp_taskVo.set("pageIndex", "1");
            pgl_taskList.setSelectedIndex(1);

            // 서버통신 - 업무정보 조회
            $c.sbm.execute($p, sbm_selectTaskVoList);
        }, 10)
    }
};

// 추가 버튼 >> 행 추가
scwin.btn_add_onclick = function (e) {
    let rowIdx = dlt_taskVoList.insertRow(0);
    grd_list.setCellReadOnly(rowIdx, "taskId", true);

};

// 저장 버튼
scwin.btn_save_onclick = function (e) {
    // 다건 신규입력, 수정, 삭제 한꺼번에 처리
    let reqObj = {
        "elData": { "taskVoList": dlt_taskVoList.getModifiedJSON() }
    };
    $c.sbm.execute(sbm_saveTaskVoList, reqObj);
};

// 삭제 버튼
scwin.btn_delete_onclick = function (e) {
    let chkArrIdx = grd_list.getCheckedIndex("chk")
    dlt_taskVoList.deleteRows(chkArrIdx);

};


// 저장 이후 수행되는 로직
scwin.sbm_saveTaskVoList_submitdone = function (e) {
    // error 수신시
    var elHeader = e.responseJSON.elHeader;
    if (elHeader == null || elHeader == "" || elHeader == "undefiend" || elHeader.resSuc == false) {
        $c.win.alert(`에러코드 : ${elHeader.resCode}\n에러메시지 : ${elHeader.resMsg}`);
        return false;
    } else {
        // msg 출력
        $c.win.alert("저장되었습니다.");
    }

    // 재조회
    scwin.btn_search_onclick();
};






scwin.grd_list_oncelldblclick = function (rowIndex, columnIndex, columnId) {

    // 더블클릭으로 선택된 한 행의 데이터
    let rowData = dlt_taskVoList.getRowJSON(rowIndex)
    var jsnPopupData = {
        "type": "json", // 데이터 유형. "json"을 권장
        "name": "taskData",  // 데이터를 가져오기 위한 파라미터 이름으로 팝업 화면에서 $p.getParameter("taskData")로 추출할 수 있음
        "data": rowData
    }

    // 팝업 생성 옵션 지정
    var options = {
        id: "task_popup",
        type: "wframePopup",
        width: "1000px",
        height: "600px",
        top: "130px",
        left: "200px",
        popupName: "업무 상세 팝업",
        modal: true,
        closeAction: "scwin.popup_closeAction", // [선택] 팝업의 닫기 버튼을 클릭했을 때 실행할 함수명
        dataObject: jsnPopupData
    };

    // 팝업 생성
    $p.openPopup("task/TaskDetailPopup.xml", options);
};

scwin.popup_closeAction = function () {

    // 재조회
    scwin.btn_search_onclick();

    return true;
}


]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="sub_contents " id="" style="">
			<xf:group class="pgtbox" id="" style="">
				<w2:textbox class="pgt_tit" id="" label="업무정보" style="" tagname="" />
			</xf:group>
			<xf:group class="schbox" id="search_box" style="">
				<xf:group class="schbox_inner" id="" style="">
					<xf:group adaptive="layout" adaptiveThreshold="1200" class="w2tb tbl" id="" style="width:Infinity%;" tagname="table">
						<w2:attributes>
							<w2:summary />
						</w2:attributes>
						<xf:group tagname="colgroup">
							<xf:group id="searchComp_1" style="width:100px;" tagname="col" />
							<xf:group id="searchComp_2" style="" tagname="col" />

						</xf:group>
