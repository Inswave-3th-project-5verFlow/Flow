								<xf:group class="w2tb_th" style="" tagname="th">
									<w2:textbox class="" id="" label="task_name" style="" localeRef="Task_SEARCH_00001" />
								</xf:group>
								<xf:group class="w2tb_td" id="" style="" tagname="td">
									<xf:input class="" id="scTaskName" placeholder="" style="width:200px;" ref="data:dmp_taskVo.scTaskName"
										ev:onkeyup="scwin.scTaskName_onkeyup">
									</xf:input>
								</xf:group>

							</xf:group>
						</xf:group>
