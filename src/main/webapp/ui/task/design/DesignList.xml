		<script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function () {
    //search_box
    var cptIbxName = $p.getComponentById("searchComp_1");
    if (cptIbxName == undefined) {
        search_box.hide();
    }

    // 설계 업무 정보 조회
    scwin.btn_search_onclick();
};

/************************** 이벤트 함수 *************************/

/**
 * 조회 버튼 클릭 이벤트
 * @date
 * @memberOf
 * @param 
 * @returns
 * @author 
 * @example
 */
scwin.btn_search_onclick = function (e) {

    // PGAE번호 초기화
    dmp_designVo.set("pageIndex", "1");
    pgl_designList.setSelectedIndex(1);

    // 서버통신 - 설계 업무 정보 조회
    $c.sbm.execute($p, sbm_selectDesignVoList);
};

scwin.sbm_designList_submitdone = function (e) {

    // error 수신시
    var elData = e.responseJSON.elData;
    var elHeader = e.responseJSON.elHeader;

    console.log(elData);
    if (elHeader == null || elHeader == "" || elHeader == "undefiend" || elHeader.resSuc == false) {
        $c.win.alert(`에러코드 : ${elHeader.resCode}\n에러메시지 : ${elHeader.resMsg}`);
        return false;
    }

    // 설계 업무 정보 dataMap 초기화
    dmp_designVoDetail.setEmptyValue();

    // 총 레코드 수 업데이트
    spn_listCnt.setLabel(elData.totalCount);

    // 데이터를 그리드에 셋팅
    dlt_designVoList.setJSON(elData.designVoList);

    // 페이지 네비게이터 업데이트
    var totalPageCount = Math.ceil(elData.totalCount / dmp_designVo.get("pageSize"));
    pgl_designList.setCount(totalPageCount);

    // 페이징 정보 업데이트
    spn_totalPageCount.setValue(totalPageCount);
    spn_pageIndex.setValue(dmp_designVo.get("pageIndex"));
    pgl_designList.setSelectedIndex(dmp_designVo.get("pageIndex"));
};

/**
 * 페이지 번호 클릭 이벤트
 * @date
 * @memberOf
 * @param 
 * @returns 
 * @author 
 * @example
 */
scwin.pgl_designList_onclick = function (idx) {

    // 페이지 번호 세팅
    dmp_designVo.set("pageIndex", idx);
    // 서버통신 - 사원목록 조회
    $c.sbm.execute($p, sbm_selectDesignVoList);
};




scwin.btn_reseet_onclick = function (e) {
    dmp_designVo.set("scTaskName", "");
    dmp_designVo.set("scTaskStatus", "");
    dmp_designVo.set("scIsTest", "");
    dmp_designVo.set("scStgId", "");

    // PGAE번호 초기화
    dmp_designVo.set("pageIndex", "1");
    pgl_designList.setSelectedIndex(1);

    // 서버통신 - 설계 업무 정보 조회
    $c.sbm.execute($p, sbm_selectDesignVoList);
};

// 행 추가 버튼 >> 행 추가
scwin.btn_add_onclick = function (e) {
    let rowIdx = dlt_designVoList.insertRow(0);

};


// 삭제 버튼 >> 체크된 행(들) 삭제 상태로 변경
scwin.btn_delete_onclick = function (e) {
    let chkArrIdx = grd_list.getCheckedIndex("chk");
    dlt_designVoList.deleteRows(chkArrIdx);
};


// 저장 버튼 >> 단건 및 다건의 데이터의 상태에 따른 통합 저장(C, U, D)
scwin.btn_save_onclick = function (e) {
    let reqObj = {
        "elData": { "designVoList": dlt_designVoList.getModifiedJSON() }
    }
    $c.sbm.execute(sbm_saveDesignVoList, reqObj);
};

// 저장 이후 수행되는 로직
scwin.sbm_saveDesignVoList_submitdone = function (e) {
    // error 수신시
    var elHeader = e.responseJSON.elHeader;
    if (elHeader == null || elHeader == "" || elHeader == "undefiend" || elHeader.resSuc == false) {
        $c.win.alert(`에러코드 : ${elHeader.resCode}\n에러메시지 : ${elHeader.resMsg}`);
        return false;
    } else {
        // msg 출력
        $c.win.alert("저장되었습니다.");
    }

    // 재조회
    scwin.btn_search_onclick();
};


// 그리드 셀 클릭 이벤트
scwin.grd_list_oncellclick = function (row, col, colId) {
    console.log("클릭된 셀:", row, col, colId);

    // 상위 업무명 컬럼을 클릭한 경우
    if (colId === "ptTaskName") {
        scwin.openParentTaskPopup(row);
    }
};

// 상위 업무 선택 팝업 열기
scwin.openParentTaskPopup = function (rowIndex) {
    console.log("더블클릭된 행:", rowIndex);
    
    // 더블클릭으로 선택된 한 행의 데이터
    let rowData = dlt_designVoList.getRowJSON(rowIndex);
    console.log("선택된 행 데이터:", rowData);
    
    // 팝업으로 넘길 데이터 구조화
    var taskData = {
        currentTaskId: rowData.taskId,
        currentTaskName: rowData.taskName,
        currentRowIndex: rowIndex,
        currentStgId: rowData.stgId
    };
    
    console.log("팝업으로 전달할 데이터:", taskData);
    
    // 팝업 데이터 구성
    var jsnPopupData = {
        "type": "json",
        "name": "taskData",
        "data": taskData
    };

    // 팝업 생성 옵션 지정
    var options = {
        id: "task_tree_popup",
        type: "wframePopup",
        width: "600px",
        height: "700px",
        top: "100px",
        left: "300px",
        popupName: "업무 트리 선택",
        modal: true,
        closeAction: "scwin.taskTreePopup_closeAction",
        dataObject: jsnPopupData
    };

    // 팝업 생성 (업무 트리 선택 팝업)
    $p.openPopup("TaskTree.xml", options);
};

// 팝업 닫기 콜백 함수
scwin.taskTreePopup_closeAction = function (returnData) {
    console.log("팝업에서 반환된 데이터:", returnData);
    
    if (returnData && returnData.selectedTask) {
        var selectedTask = returnData.selectedTask;
        var currentRowIndex = returnData.currentRowIndex;
        
        console.log("선택된 업무:", selectedTask);
        console.log("현재 행 번호:", currentRowIndex);
        
        // 현재 행의 데이터 업데이트 (예: 상위 업무 ID 설정)
        if (currentRowIndex !== null && currentRowIndex >= 0) {
            // 예시: 상위 업무 ID를 업데이트하는 경우
            // dlt_taskVoList.setCellData(currentRowIndex, "ptTaskId", selectedTask.taskId);
            
            $c.win.alert(`선택된 업무: ${selectedTask.taskName}\n현재 행: ${currentRowIndex}`);
        }
    }
    
    return true;
};]]></script>
