		<script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function () {
    /*
        * 참고사항
             - 특정 요소를 선택하여 CSS를 직접 적용하는 방식입니다.
             - 본 샘플은 조회된 데이터를 기반으로 CSS 스타일을 설정하는 예시입니다. (샘플은 하드 코딩으로 데이터를 바인딩해놓은 상태입니다.)
             - 해당 컬럼은 readonly: true로 설정되어 수정이 차단된 상태입니다.
     */
    let percentValue = dlt_sample.getColData("percentData");
    for (let i = 0; i < percentValue.length; i++) {
        let cell = $("td[data-colindex='4']").eq(i).find(".w2grid_input");
        if (cell.length > 0) {
            cell.css({
                width: "100px",
                height: "14px",
                display: "inline-block",
                borderRadius: "3px",
                background: `linear-gradient(to right, #434dbb ${percentValue[i]}%, #d3d6ed ${percentValue[i]}%)`
            }).text("");
        }
    }
}

]]></script>
