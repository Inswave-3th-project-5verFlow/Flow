		<script lazy="false" type="text/javascript"><![CDATA[// 전역 변수 초기화
scwin.LOGIN_USER_ID = "";
scwin.PJT_ID = "";

/**
 * @method
 * @name scwin.onpageload
 * @description
 * @example
 * scwin.onpageload();
 */
scwin.onpageload = function () {
    scwin.LOGIN_USER_ID = "1";
    scwin.PJT_ID = "1";

    // 검색 조건 초기화
    dmp_wbsVo.set("pjtId", scwin.PJT_ID);

    // 단계 목록 조회 서브미션 호출
    $c.sbm.execute(sbm_selectWbsStgVoList, {
        elData: {}
    });

    // WBS 조회
    scwin.btn_search_onclick();
};

/**
 * 조회 버튼 클릭 이벤트
 * @date
 * @memberOf
 * @param 
 * @returns
 * @author 
 * @example
 */
scwin.btn_search_onclick = function (e) {

    // PGAE번호 초기화
    dmp_wbsVo.set("pageIndex", "1");
    pgl_wbsList.setSelectedIndex(1);

    // 서버통신 - WBS 조회
    $c.sbm.execute(sbm_selectWbsVoList);
};

/**
 * 페이지 번호 클릭 이벤트
 * @date
 * @memberOf
 * @param 
 * @returns 
 * @author 
 * @example
 */
scwin.pgl_wbsList_onclick = function (idx) {

    // 페이지 번호 세팅
    dmp_wbsVo.set("pageIndex", idx);
    // 서버통신 - 사원목록 조회
    $c.sbm.execute(sbm_selectWbsVoList);
};

/**
 * 기존 서브미션 완료 함수 수정
 * 데이터 로드 완료 후 자동으로 단계별 그룹핑 적용
 */
scwin.sbm_wbsList_submitdone = function (e) {
    // error 수신시
    var elData = e.responseJSON.elData;
    var elHeader = e.responseJSON.elHeader;
    if (elHeader == null || elHeader == "" || elHeader == "undefiend" || elHeader.resSuc == false) {
        $c.win.alert(`에러코드 : ${elHeader.resCode}\n에러메시지 : ${elHeader.resMsg}`);
        return false;
    }

    // WBS dataMap 초기화
    dmp_wbsVoDetail.setEmptyValue();

    // 총 레코드 수 업데이트
    spn_listCnt.setLabel(elData.totalCount);

    // // 데이터에 단계명 추가 및 그룹핑을 위한 단계 순서 필드 추가
    var wbsDataWithStgName = elData.wbsVoList.map(function (item) {
        // 단계ID로 단계명 조회하여 추가
        item.stgName = scwin.getStgNameByStgId(item.stgId);
        // 그룹핑을 위한 단계정보 필드 (순서를 위해 stgId 사용, 표시를 위해 stgName 사용)
        item.stgForGrouping = item.stgId + '|' + item.stgName; // 'STG001|분석단계' 같은 형태
        return item;
    });

    dlt_wbsVoList.setJSON(wbsDataWithStgName);
    // dlt_wbsVoList.setJSON(elData.wbsVoList);

    // 페이지 네비게이터 업데이트
    var totalPageCount = Math.ceil(elData.totalCount / dmp_wbsVo.get("pageSize"));
    pgl_wbsList.setCount(totalPageCount);

    // 페이징 정보 업데이트
    spn_totalPageCount.setValue(totalPageCount);
    spn_pageIndex.setValue(dmp_wbsVo.get("pageIndex"));
    pgl_wbsList.setSelectedIndex(dmp_wbsVo.get("pageIndex"));

    // 순번 업데이트
    let num = Number(dmp_wbsVo.get("pageIndex"));
    num = (num - 1) * 10;
    grd_list.setStartRowNumber(num);

};

/**
 * 단계별 그룹핑 함수
 */
scwin.initGroupBy = function () {
    var options = {
        sortIndex: [1],     // stgName(1) - 단계명으로 정렬
        sortOrder: [1],      // 오름차순
        closeGroup: false,
        groupbyHeader: [
            {
                inputType: "expression",
                // 단계별 그룹 헤더 - 단계명으로 표시
                expression: 'toggle() + depthStr() + " (" + count() + " 건) "',
                align: "left",
                colSpan: "18"
            }
        ],
        hideFooter: true
    };

    // 그룹핑 실행
    grd_list.groupby(options);
};

scwin.sbm_selectWbsStgVoList_submitdone = function (e) {
    var elData = e.responseJSON.elData;
    var elHeader = e.responseJSON.elHeader;
    if (elHeader == null || elHeader == "" || elHeader == "undefiend" || elHeader.resSuc == false) {
        $c.win.alert(`에러코드 : ${elHeader.resCode}\n에러메시지 : ${elHeader.resMsg}`);
        return false;
    }

    dlt_wbsStgList.setJSON(elData.wbsStgVoList);
};

// stgId로 단계명 조회
scwin.getStgNameByStgId = function (value) {
    /*
    Parameters:
    matchColumnInfo - Number||String:Y - 데이터를 검사할 컬럼의 인덱스 또는 아이디
    data - String:Y - 비교 데이터
    targetColumn - Number||String:Y - 꺼내올 데이터의 컬럼 인덱스 또는 컬럼 아이디

    Return:
    Array - targetCol에 해당하는 데이터가 담긴 1차원 배열
    var tmpRsData = dlt_dataList1.getMatchedColumnData("dept","인사","name");
    반환 값 예시 )["손예진" , "류승룡"]
    */
    var _stgName = dlt_wbsStgList.getMatchedColumnData("stgId", value, "stgName");
    return _stgName[0];
}

// 그룹바이
scwin.btn_groupby_onclick = function (e) {
    // 단계별 그룹핑 함수 호출
    scwin.initGroupBy();
};

// 그룹바이 초기화
scwin.btn_clearGroupby_onclick = function (e) {
    grd_list.clearGroupby();
};

// 등록 버튼
scwin.btn_new_onclick = function (e) {
    var popupData = {
        "type": "json",
        "name": "params",
        "data": {
            "pjtId": scwin.PJT_ID,
            "popupType" : "new"
        }
    };

    const screenWidth = window.innerWidth;
    const screenHeight = window.innerHeight;
    const popupWidth = 800;
    const popupHeight = 800;
    const popupLeft = (screenWidth - popupWidth) / 2 + "px";
    const popupTop = (screenHeight - popupHeight) / 2 + "px";

    const options = {
        id: "wbs_new",
        type: "wframePopup",
        width: popupWidth + "px",
        height: popupHeight + "px",
        top: popupTop,
        left: popupLeft,
        popupName: "업무 생성",
        modal: true,
        closeAction: "scwin.popup_closeAction",
        dataObject: popupData
    };

    $p.openPopup("/InsWebApp/ui/wbs/WbsDetail.xml", options);
};

scwin.grd_list_oncellclick = function (rowIndex, columnIndex, columnId) {

};

/**
 * @method
 * @name scwin.popup_closeAction
 * @description 팝업 닫기 시 재조회 처리
 * @param {String} argRuntimeID - 팝업의 실행 ID
 * @param {Object} argJsnInfo - 팝업 닫힘 시 전달된 정보
 * @returns {Boolean} 팝업 닫기 여부
 */
scwin.popup_closeAction = function (argRuntimeID, argJsnInfo) {
    var popObj = $p.getPopupWindow(argRuntimeID);
    scwin.btn_search_onclick();
    return true;
};
]]></script>
