		<script lazy="false" type="text/javascript"><![CDATA[// 전역 변수 선언
scwin.PJT_ID = "";

/**
 * @method
 * @name scwin.onpageload
 * @description 팝업 페이지 로드 시 전달된 프로젝트 ID를 설정하고 그룹 목록 및 사용자 목록을 조회한다.
 * @example
 * scwin.onpageload();
 */
scwin.onpageload = function () {
    const popUpdata = $p.getParameter("params");
    scwin.PJT_ID = popUpdata.pjtId;

    // 그룹 목록 조회
    $c.sbm.execute(sbm_selectGrpVoList, {
        "elData": {}
    });

    // 사용자 목록 조회
    scwin.btn_search_onclick();
};

/**
 * @method
 * @name scwin.btn_search_onclick
 * @description 조회 버튼 클릭 시 사용자 목록을 조회하는 서브미션을 실행한다.
 * @param {Event} e - 클릭 이벤트 객체
 * @example
 * <w2:trigger id="btn_search" onClick="scwin.btn_search_onclick" />
 */
scwin.btn_search_onclick = function (e) {
    $c.sbm.execute(sbm_selectUserVoList);
};

/**
 * @method
 * @name scwin.sbm_selectUserVoList_submitdone
 * @description 사용자 목록 조회 완료 후 결과를 화면에 바인딩하고 페이징 정보를 갱신한다.
 * @param {Object} e - 서브미션 완료 이벤트 객체
 * @example
 * <w2:submission id="sbm_selectUserVoList" submitDone="scwin.sbm_selectUserVoList_submitdone" />
 */
scwin.sbm_selectUserVoList_submitdone = function (e) {
    var elData = e.responseJSON.elData;
    var elHeader = e.responseJSON.elHeader;

    if (elHeader == null || elHeader === "" || elHeader === "undefined" || elHeader.resSuc === false) {
        $c.win.alert(`에러코드 : ${elHeader.resCode}\n에러메시지 : ${elHeader.resMsg}`);
        return false;
    }

    spn_listCnt.setLabel(elData.totalCount);
    dlt_userVoList.setJSON(elData.pugUserVoList);

    var totalPageCount = Math.ceil(elData.totalCount / dmp_userVo.get("pageSize"));
    pgl_pugList.setCount(totalPageCount);
    spn_totalPageCount.setValue(totalPageCount);
    spn_pageIndex.setValue(dmp_userVo.get("pageIndex"));
    pgl_pugList.setSelectedIndex(dmp_userVo.get("pageIndex"));

    let num = Number(dmp_userVo.get("pageIndex"));
    num = (num - 1) * 10;
    grd_list.setStartRowNumber(num);
};

/**
 * @method
 * @name scwin.pgl_pjtList_onclick
 * @description 페이지 번호 클릭 시 해당 페이지로 사용자 목록을 조회한다.
 * @param {Number} idx - 선택된 페이지 번호
 * @example
 * <w2:pagingNavigator id="pgl_pugList" onClick="scwin.pgl_pjtList_onclick" />
 */
scwin.pgl_pjtList_onclick = function (idx) {
    dmp_userVo.set("pageIndex", idx);
    $c.sbm.execute(sbm_selectUserVoList);
};

/**
 * @method
 * @name scwin.btn_new_onclick
 * @description 신규 등록 버튼 클릭 시 사용자 ID와 선택한 그룹 ID를 기반으로 사용자-그룹 매핑을 등록한다.
 * @param {Event} e - 클릭 이벤트 객체
 * @example
 * <w2:trigger id="btn_new" onClick="scwin.btn_new_onclick" />
 * 
 */
scwin.btn_new_onclick = function (e) {
    // 다건 처리로 통합
    let reqObj = {
        "elData": {
            "pugVoList": [{
                "pjtId": scwin.PJT_ID,
                "userId": ipt_userId.getValue(),
                "grpId": slt_grp.getValue(),
                "rowStatus" : "C"
            }]
        }
    };    
    $c.sbm.execute(sbm_insertPugVo, reqObj);
};

/**
 * @method
 * @name scwin.sbm_insertPugVo_submitdone
 * @description 사용자-그룹 매핑 등록 완료 후 결과 메시지를 출력한다.
 * @param {Object} e - 서브미션 완료 이벤트 객체
 * @example
 * <w2:submission id="sbm_insertPugVo" submitDone="scwin.sbm_insertPugVo_submitdone" />
 */
scwin.sbm_insertPugVo_submitdone = function (e) {
    var elData = e.responseJSON.elData;
    var elHeader = e.responseJSON.elHeader;

    if (elHeader == null || elHeader === "" || elHeader === "undefined" || elHeader.resSuc === false) {
        $c.win.alert(`에러코드 : ${elHeader.resCode}\n에러메시지 : ${elHeader.resMsg}`);
        return false;
    }

    $c.win.alert("등록이 완료되었습니다.");
};

/**
 * @method
 * @name scwin.sbm_selectGrpVoList_submitdone
 * @description 그룹 목록 조회 완료 후 데이터리스트에 결과를 바인딩한다.
 * @param {Object} e - 서브미션 완료 이벤트 객체
 * @example
 * <w2:submission id="sbm_selectGrpVoList" submitDone="scwin.sbm_selectGrpVoList_submitdone" />
 */
scwin.sbm_selectGrpVoList_submitdone = function (e) {
    var elData = e.responseJSON.elData;
    var elHeader = e.responseJSON.elHeader;

    if (elHeader == null || elHeader === "" || elHeader === "undefined" || elHeader.resSuc === false) {
        $c.win.alert(`에러코드 : ${elHeader.resCode}\n에러메시지 : ${elHeader.resMsg}`);
        return false;
    }

    dlt_grpVoList.setJSON(elData.pugVoList);
};

/**
 * @method
 * @name scwin.btn_close_onclick
 * @description 닫기 버튼 클릭 시 현재 팝업을 닫는다.
 * @param {Event} e - 클릭 이벤트 객체
 * @example
 * <w2:trigger id="btn_close" onClick="scwin.btn_close_onclick" />
 */
scwin.btn_close_onclick = function (e) {
    $p.closePopup();
};
]]></script>
