		<script lazy="false" type="text/javascript"><![CDATA[scwin.LOGIN_USER_ID = "";
scwin.PJT_ID = "";

scwin.onpageload = function () {
    scwin.LOGIN_USER_ID = "1";
    scwin.PJT_ID = "1";
    dmp_pugVo.set("pjtId", scwin.PJT_ID);
    scwin.btn_search_onclick();
};

/************************** 이벤트 함수 *************************/

/**
 * 조회 버튼 클릭 이벤트
 * @date
 * @memberOf
 * @param 
 * @returns
 * @author 
 * @example
 */
scwin.btn_search_onclick = function (e) {

    // PGAE번호 초기화
    dmp_pugVo.set("pageIndex", "1");
    pgl_pugList.setSelectedIndex(1);

    // 서버통신 - 메뉴 그룹 정보 조회
    $c.sbm.execute(sbm_selectGrpVoList);

    // 서버통신 - 프로젝트 유저 그룹 매핑 정보 조회
    $c.sbm.execute(sbm_selectPugVoList);

};

scwin.sbm_pugList_submitdone = function (e) {

    // error 수신시
    var elData = e.responseJSON.elData;
    var elHeader = e.responseJSON.elHeader;
    if (elHeader == null || elHeader == "" || elHeader == "undefiend" || elHeader.resSuc == false) {
        $c.win.alert(`에러코드 : ${elHeader.resCode}\n에러메시지 : ${elHeader.resMsg}`);
        return false;
    }

    // 총 레코드 수 업데이트
    spn_listCnt.setLabel(elData.totalCount);

    // 데이터를 그리드에 셋팅
    dlt_pugVoList.setJSON(elData.pugVoList);

    // 페이지 네비게이터 업데이트
    var totalPageCount = Math.ceil(elData.totalCount / dmp_pugVo.get("pageSize"));
    pgl_pugList.setCount(totalPageCount);

    // 페이징 정보 업데이트
    spn_totalPageCount.setValue(totalPageCount);
    spn_pageIndex.setValue(dmp_pugVo.get("pageIndex"));
    pgl_pugList.setSelectedIndex(dmp_pugVo.get("pageIndex"));

    let num = Number(dmp_pugVo.get("pageIndex"));
    num = (num - 1) * 10;
    grd_list.setStartRowNumber(num);
};

/**
 * 페이지 번호 클릭 이벤트
 * @date
 * @memberOf
 * @param 
 * @returns 
 * @author 
 * @example
 */
scwin.pgl_pugList_onclick = function (idx) {

    // 페이지 번호 세팅
    dmp_pugVo.set("pageIndex", idx);
    // 서버통신 - 사원목록 조회
    $c.sbm.execute($p, sbm_selectPugVoList);
};


scwin.sbm_selectGrpVoList_submitdone = function (e) {
    // error 수신시
    var elData = e.responseJSON.elData;
    var elHeader = e.responseJSON.elHeader;
    if (elHeader == null || elHeader == "" || elHeader == "undefiend" || elHeader.resSuc == false) {
        $c.win.alert(`에러코드 : ${elHeader.resCode}\n에러메시지 : ${elHeader.resMsg}`);
        return false;
    }
    // 메뉴 그룹 데이터 셋팅
    dlt_grpVoList.setJSON(elData.pugVoList);
};

scwin.btn_delete_onclick = function (e) {
    let chkArrIdx = grd_list.getCheckedIndex("chk")
    dlt_pugVoList.deleteRows(chkArrIdx);
};

scwin.btn_save_onclick = function (e) {
    // 다건 신규입력, 수정, 삭제 한꺼번에 처리
    let reqObj = {
        "elData": { "pugVoList": dlt_pugVoList.getModifiedJSON() }
    };
    $c.sbm.execute(sbm_savePugVoList, reqObj);
};

scwin.sbm_savePugVoList_submitdone = function (e) {
    // error 수신시
    var elHeader = e.responseJSON.elHeader;
    if (elHeader == null || elHeader == "" || elHeader == "undefiend" || elHeader.resSuc == false) {
        $c.win.alert(`에러코드 : ${elHeader.resCode}\n에러메시지 : ${elHeader.resMsg}`);
        return false;
    } else {
        // 삭제되었습니다. msg 출력
        $c.win.alert("통합 수정되었습니다.");
    }

    // 재조회
    scwin.btn_search_onclick();
};

scwin.dlt_pugVoList_oncelldatachange = function (info) {
    if (info.colID === "grpName" && info.newValue) {
        let matched = $c.data.getMatchedJSON(dlt_grpVoList, {
            columnId: "grpName",
            operator: "==",
            value: info.newValue
        });
        console.log(matched);
        if (matched.length > 0) {
            dlt_pugVoList.setCellData(info.rowIndex, "grpId", matched[0].grpId);
        } else {

        }
    }
};
