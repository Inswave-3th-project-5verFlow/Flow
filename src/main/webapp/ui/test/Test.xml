        <script lazy="false" type="text/javascript"><![CDATA[
    scwin.onpageload = function() {
        // 이 파일은 이제 "테스트결함관리" (Defect) 화면으로 사용될 것이므로, 관련 텍스트 및 ID를 변경
        
        // 메인 화면 버튼 상태 초기화
        // '저장' 버튼은 등록 모드일 때만 보이고, '수정', '삭제'는 숨김
        btn_save.show();
        btn_edit.hide();
        btn_delete.hide();
        
        // 페이지 크기 설정 (주석 해제)
        // sel_pageSize 컴포넌트가 있다면 (HTML 주석 해제된 경우)
        // if (typeof sel_pageSize !== 'undefined') {
        //     sel_pageSize.setValue("10"); // 기본 페이지 사이즈 설정
        // }
        
        // 검색 박스 숨김 로직 (searchComp_1이 실제 검색 인풋이라면 유지)
        var searchBoxComp = $p.getComponentById("search_box");
        var searchComp1 = $p.getComponentById("searchComp_1"); // HTML에서 검색 필드로 사용될 ID
        if(searchBoxComp && searchComp1 === undefined){ // searchComp_1이 실제로 정의되지 않았다면
            searchBoxComp.hide();
        }
        
        // 테스트결함관리 조회 (페이지 로드 시 자동 조회)
        // dmp_defVo로 변경 (페이지네이션 정보 포함)
        dmp_defVo.set("pageIndex", "1");
        dmp_defVo.set("pageSize", "10"); // 실제 페이지 사이즈
        scwin.btn_search_onclick();
    };

    /************************** 이벤트 함수 *************************/
    
    /**
     * 조회 버튼 클릭 이벤트
     */        
    scwin.btn_search_onclick = function(e) {
        // 페이지 번호 초기화
        dmp_defVo.set("pageIndex","1");
        pgl_defList.setSelectedIndex(1); // pgl_testList -> pgl_defList 변경
        
        // 서버통신 - 테스트결함관리 조회 (Submission ID 변경)
        $c.sbm.execute($p, sbm_selectDefVoList);
    };
    
    // 테스트결함 목록 조회 완료 콜백 (sbm_testList_submitdone -> sbm_defList_submitdone)
    scwin.sbm_defList_submitdone = function(e) {
        // error 수신시
        var elData = e.responseJSON.elData;
        var elHeader = e.responseJSON.elHeader;
        if(elHeader == null || elHeader == "" || elHeader == "undefiend" || elHeader.resSuc == false) {
            $c.win.alert(`에러코드 : ${elHeader.resCode}\n에러메시지 : ${elHeader.resMsg}`);
            return false;
        }

        // 테스트결함 dataMap 초기화
        dmp_defVoDetail.setEmptyValue();
        
        // 테스트결함 readOnly false
        if (typeof grp_defInfo !== 'undefined') {
            grp_defInfo.setReadOnly(false);
        } else {
            console.warn("grp_defInfo 컴포넌트를 찾을 수 없습니다. HTML에서 ID를 확인하세요.");
        }
        
        // 버튼 상태 초기화 (메인 화면의 저장/수정/삭제 버튼)
        btn_save.show();
        btn_edit.hide();
        btn_delete.hide();        

        // 총 레코드 수 업데이트
        spn_listCnt.setLabel(elData.totalCount);
        
        // 데이터를 그리드에 셋팅
        dlt_defVoList.setJSON(elData.defVoList);
        
        // 페이지 네비게이터 업데이트 - 여기가 핵심 수정 부분
        var currentPageIndex = parseInt(dmp_defVo.get("pageIndex")) || 1;
        var pageSize = parseInt(dmp_defVo.get("pageSize")) || 10;
        var totalPageCount = Math.ceil(elData.totalCount / pageSize);
        
        // 총 페이지 수 설정
        pgl_defList.setCount(totalPageCount);
        
        // 현재 페이지 설정 - 이 부분이 중요합니다
        pgl_defList.setSelectedIndex(currentPageIndex);
        
        spn_registerFlag.setValue("등록"); // 등록/수정 플래그

        // 페이징 정보 업데이트
        dmp_defVo.set("totalPageCount", totalPageCount);
        spn_totalPageCount.setValue(totalPageCount);
        spn_pageIndex.setValue(currentPageIndex);
        
        console.log("페이징 정보 - 현재페이지:", currentPageIndex, "총페이지:", totalPageCount);
    };  

    /**
     * 페이지 번호 클릭 이벤트 (pgl_testList_onclick -> pgl_defList_onclick)
     */
    scwin.pgl_defList_onclick = function(idx) {
        console.log("페이지 클릭:", idx);
        
        // 페이지 번호 세팅
        dmp_defVo.set("pageIndex", idx);
        
        // 페이지 사이즈 설정 (고정값 또는 selectbox에서 가져오기)
        var pageSize = "10"; // 기본값
        if (typeof sel_pageSize !== 'undefined') {
            pageSize = sel_pageSize.getValue() || "10";
        }
        dmp_defVo.set("pageSize", pageSize);
        
        // 서버통신 - 테스트결함관리 조회
        $c.sbm.execute($p, sbm_selectDefVoList);
    };

    // 테스트결함관리 초기화 (dmp_testVoDetail -> dmp_defVoDetail, grp_testInfo -> grp_defInfo)
    scwin.btn_reset_onclick = function(e) {
    // 테스트결함관리 dataMap 초기화
    dmp_defVoDetail.setEmptyValue();
    // 테스트결함관리 readOnly false
    if (typeof grp_defInfo !== 'undefined') {
        grp_defInfo.setReadOnly(false);
    } else {
        console.warn("grp_defInfo 컴포넌트를 찾을 수 없습니다.");
    }

    // 버튼 상태 설정
    btn_save.show();
    btn_edit.hide();
    btn_delete.hide();
    
    spn_registerFlag.setValue("등록");
};

    /**
     * 그리드 셀 클릭 이벤트 (메인 그리드)
     */
    scwin.grd_list_oncellclick = function(row,col,colId) {
        // dmp_testVoDetail -> dmp_defVoDetail, dlt_testVoList -> dlt_defVoList
        dmp_defVoDetail.setJSON(dlt_defVoList.getRowJSON(row));

        // 버튼 상태 변경
        btn_save.hide();
        btn_edit.show();
        btn_delete.show();
        
        spn_registerFlag.setValue("수정");
    };

    /**
     * 저장 버튼 클릭 이벤트 (등록)
     */ 
    scwin.btn_save_onclick = function(e) {
        // 유효성 체크 (grp_testInfo -> grp_defInfo)
        var valInfo = [
            { id: "name", mandatory: true }, // 결함명 필수 (예시)
            { id: "testId", mandatory: true }, // 연결된 테스트 ID 필수 (예시)
            { id: "userId", mandatory: true } // 담당자 ID 필수 (예시)
        ];
        
        // grp_testInfo를 grp_defInfo로 변경. 팝업 내부의 그룹 ID와 일치시켜야 함.
        var targetGroup = $p.getComponentById("grp_popupForm"); // 팝업 내 상세 폼 그룹 ID로 가정
        if (targetGroup && $c.data.validateGroup(targetGroup, valInfo) === true) {
            var promise = $c.win.confirm("저장하시겠습니까?");
            promise.then(function(result) {  
                if (result){
                    $c.sbm.execute(sbm_insertDefVo); // Submission ID 변경
                }
            })
        } else if (!targetGroup) {
                console.error("팝업 상세 폼 그룹 (grp_popupForm)을 찾을 수 없습니다. 유효성 검사 대상을 확인하세요.");
        }
    };

    /**
     * 등록 완료 콜백 (sbm_insertTestVo_submitdone -> sbm_insertDefVo_submitdone)
     */
    scwin.sbm_insertDefVo_submitdone = function(e) {
        // error 수신시
        var elHeader = e.responseJSON.elHeader;
        if(elHeader == null || elHeader == "" || elHeader == "undefiend" || elHeader.resSuc == false) {
            $c.win.alert(`에러코드 : ${elHeader.resCode}\n에러메시지 : ${elHeader.resMsg}`);
            return false;
        }else{
            $c.win.alert("등록되었습니다.");
        }
        
        // 팝업 닫기 (팝업 ID를 'popup_grp'으로 변경)
        if (typeof popup_grp !== 'undefined') {
            popup_grp.hide();
        }
        // 재조회
        scwin.btn_search_onclick();
    };

    /**
     * 수정 버튼 클릭 이벤트
     */     
    scwin.btn_edit_onclick = function(e) {
        // 유효성 체크
        var valInfo = [
            { id: "id", mandatory: true },
            { id: "name", mandatory: true },
            { id: "testId", mandatory: true },
            { id: "userId", mandatory: true }
        ];
        
        var targetGroup = $p.getComponentById("grp_popupForm"); // 팝업 내 상세 폼 그룹 ID로 가정
        if (targetGroup && $c.data.validateGroup(targetGroup, valInfo) === true) {
            var promise = $c.win.confirm("수정하시겠습니까?");
            promise.then(function(result) {  
                if (result){
                    $c.sbm.execute(sbm_updateDefVo); // Submission ID 변경
                }
            })
        } else if (!targetGroup) {
                console.error("팝업 상세 폼 그룹 (grp_popupForm)을 찾을 수 없습니다. 유효성 검사 대상을 확인하세요.");
        }
    };

    /**
     * 수정 완료 콜백 (sbm_updateTestVo_submitdone -> sbm_updateDefVo_submitdone)
     */
    scwin.sbm_updateDefVo_submitdone = function(e) {
        // error 수신시
        var elHeader = e.responseJSON.elHeader;
        if(elHeader == null || elHeader == "" || elHeader == "undefiend" || elHeader.resSuc == false) {
            $c.win.alert(`에러코드 : ${elHeader.resCode}\n에러메시지 : ${elHeader.resMsg}`);
            return false;
        }else{
            $c.win.alert("수정되었습니다.");
        }
        // 팝업 닫기 (팝업 ID를 'popup_grp'으로 변경)
        if (typeof popup_grp !== 'undefined') {
            popup_grp.hide();
        }
        // 재조회
        scwin.btn_search_onclick();
    };

    /**
     * 삭제 버튼 클릭 이벤트
     */     
    scwin.btn_delete_onclick = function(e) {
        // 유효성 체크
        var valInfo = [
            { id: "id", mandatory: true }
        ];
        
        var targetGroup = $p.getComponentById("grp_popupForm"); // 팝업 내 상세 폼 그룹 ID로 가정
        if (targetGroup && $c.data.validateGroup(targetGroup, valInfo) === true) {
            var promise = $c.win.confirm("삭제하시겠습니까?");
            promise.then(function(result) {  
                if (result){
                    $c.sbm.execute(sbm_deleteDefVo); // Submission ID 변경
                }
            })
        } else if (!targetGroup) {
                console.error("팝업 상세 폼 그룹 (grp_popupForm)을 찾을 수 없습니다. 유효성 검사 대상을 확인하세요.");
        }
    };

    /**
     * 삭제 콜백 (sbm_deleteTestVo_submitdone -> sbm_deleteDefVo_submitdone)
     */
    scwin.sbm_deleteDefVo_submitdone = function(e) {
        // error 수신시
        var elHeader = e.responseJSON.elHeader;
        if(elHeader == null || elHeader == "" || elHeader == "undefiend" || elHeader.resSuc == false) {
            $c.win.alert(`에러코드 : ${elHeader.resCode}\n에러메시지 : ${elHeader.resMsg}`);
            return false;
        }else{
            $c.win.alert("삭제되었습니다.");
        }
        // 팝업 닫기 (팝업 ID를 'popup_grp'으로 변경)
        if (typeof popup_grp !== 'undefined') {
            popup_grp.hide();
        }
        // 재조회
        scwin.btn_search_onclick();
    };

    // 그리드 더블클릭 시 팝업 열기 (grd_list_oncelldblclick)
    scwin.grd_list_oncelldblclick = function (rowIndex, columnIndex, columnId) {
        // 선택된 행의 데이터를 dmp_defVoDetail에 설정
        dmp_defVoDetail.setJSON(dlt_defVoList.getRowJSON(rowIndex));
        
        // 팝업 상세 정보 그룹 readOnly 해제
        var grpDefInfoPopup = $p.getComponentById("grp_popupForm"); 
        if (grpDefInfoPopup) {
            grpDefInfoPopup.setReadOnly(false);
        }

        // 팝업 제목 변경
        $p.getComponentById("textbox4").setValue("테스트결함 상세정보"); // 팝업 타이틀 텍스트박스 ID가 textbox4로 되어있다고 가정
        
        // 팝업 버튼 상태: 수정 모드 (팝업 내 버튼 ID 기준)
        // HTML상에서 팝업 내부의 저장, 수정, 삭제 버튼 ID를 확인해야 합니다.
